{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","module_id","generated_at","mode","scope","offers"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"module_id":{"const":"amazon_promotions"},"mode":{"const":"public_html_no_api"},
    "generated_at":{"type":"string","format":"date-time"},
    "scope":{"type":"object","required":["marketplace","discount_comparison"],"properties":{"marketplace":{"const":"www.amazon.ie"},"discount_comparison":{"const":">"}}},
    "offers":{"type":"array","items":{
      "type":"object","required":["id","product","pricing","verification","sources","links","distribution","status","matched_keyword_ids"],
      "properties":{
        "id":{"type":"string","pattern":"^ie-amazon-[A-Z0-9]{10}$"},
        "currency":{"const":"EUR"},"provider_id":{"const":"amazon_ie"},
        "product":{"type":"object","required":["asin","name","condition"],"properties":{"asin":{"type":"string","pattern":"^[A-Z0-9]{10}$"},"name":{"type":"string","minLength":1},"condition":{"const":"unconfirmed"}}},
        "pricing":{"type":"object","required":["device_price_minor","reference_price_minor","reference_type","discount_percent","discount_exact_fraction"],"properties":{
          "device_price_minor":{"type":"integer","minimum":1},"reference_price_minor":{"type":"integer","minimum":1},"reference_type":{"type":"string"},
          "discount_percent":{"type":"number","minimum":20,"maximum":100},"discount_exact_fraction":{"type":"object","required":["saving_minor","reference_minor"]}}},
        "verification":{"type":"object","required":["method","verified_at","discovered_at","fresh_until","source_quote_checked_at","source_updated_at","issues","amazon_page_check"],"properties":{
          "method":{"const":"public_html_third_party"},"verified_at":{"type":"null"},
          "discovered_at":{"type":"string","format":"date-time"},"fresh_until":{"type":"string","format":"date-time"},
          "source_quote_checked_at":{"type":["null","string"],"format":"date-time"},"source_updated_at":{"type":["null","string"],"format":"date-time"}}},
        "sources":{"type":"array","minItems":1,"items":{"type":"object","required":["id","url","kind","fetched_at","price_minor","reference_price_minor","reference_type"]}},
        "links":{"type":"object","required":["affiliate_url","tag"],"properties":{"affiliate_url":{"type":"string","format":"uri","pattern":"^https://www\\.amazon\\.ie/dp/[A-Z0-9]{10}\\?tag="}}},
        "distribution":{"type":"object","required":["can_list","notification_ready"],"properties":{"can_list":{"const":false},"notification_ready":{"const":false}}},
        "status":{"enum":["web_candidate","conflicting_quotes","stale"]},"matched_keyword_ids":{"type":"array","minItems":1,"items":{"type":"string"}}
      }
    }}
  }
}

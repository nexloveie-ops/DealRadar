{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema_version","module_id","module_name","generated_at","scope","offers"],
  "properties":{
    "schema_version":{"const":"1.0.0"},"module_id":{"const":"amazon_promotions"},
    "module_name":{"type":"string"},"generated_at":{"type":"string","format":"date-time"},
    "scope":{"type":"object","required":["marketplace","minimum_discount_percent"],"properties":{"marketplace":{"const":"www.amazon.ie"}}},
    "offers":{"type":"array","items":{
      "type":"object",
      "required":["id","module_id","provider_id","country","currency","product","pricing","status","verification","links","media","distribution","matched_keyword_ids"],
      "properties":{
        "id":{"type":"string","pattern":"^ie-amazon-[A-Z0-9]{10}$"},
        "module_id":{"const":"amazon_promotions"},"provider_id":{"const":"amazon_ie"},"country":{"const":"IE"},"currency":{"const":"EUR"},
        "product":{"type":"object","required":["asin","name","condition","seller"],"properties":{"asin":{"type":"string","pattern":"^[A-Z0-9]{10}$"},"name":{"type":"string","minLength":1},"condition":{"enum":["new","unconfirmed"]}}},
        "pricing":{"type":"object","required":["device_price_minor","reference_price_minor","reference_type","discount_minor","discount_percent"],"properties":{
          "device_price_minor":{"type":"integer","minimum":0},"reference_price_minor":{"type":"integer","minimum":1},"reference_type":{"type":"string"},
          "discount_minor":{"type":"integer","minimum":1},"discount_percent":{"type":"number","minimum":0,"maximum":100}}},
        "status":{"enum":["historical_candidate","needs_review"]},
        "matched_keyword_ids":{"type":"array","minItems":1,"items":{"type":"string"}},
        "verification":{"type":"object","required":["method","verified_at","expires_at","issues"],"properties":{
          "method":{"enum":["creators_api","historical_third_party_research"]},
          "verified_at":{"type":["string","null"],"format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"issues":{"type":"array","items":{"type":"string"}}}},
        "links":{"type":"object","required":["landing_url","affiliate_url","tag"],"properties":{"affiliate_url":{"type":"string","format":"uri","pattern":"^https://(www\\.)?amazon\\.ie/"}}},
        "media":{"type":"object","required":["store_image_bytes","publish_image"],"properties":{"store_image_bytes":{"const":false},"publish_image":{"const":false}}},
        "distribution":{"type":"object","required":["can_list","notification_ready"],"properties":{"can_list":{"const":false},"notification_ready":{"const":false}}}
      },
      "allOf":[{"if":{"properties":{"status":{"const":"historical_candidate"}}},"then":{"properties":{"product":{"properties":{"condition":{"const":"unconfirmed"}}},"verification":{"properties":{"verified_at":{"type":"null"},"expires_at":{"type":"null"}}}}}}]
    }}
  }
}

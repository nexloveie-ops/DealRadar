{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "module_id",
    "module_name",
    "generated_at",
    "scope",
    "offers",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "module_id": {
      "const": "retailer_promotions"
    },
    "module_name": {
      "const": "连锁零售店优惠"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope": {
      "type": "object"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider_id",
          "url",
          "fetch_status",
          "adapter_status"
        ]
      }
    },
    "offers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/offer"
      }
    }
  },
  "$defs": {
    "nullableMoney": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "nullableTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "offer": {
      "type": "object",
      "required": [
        "id",
        "module_id",
        "provider_id",
        "provider_name",
        "country",
        "currency",
        "product",
        "pricing",
        "verification",
        "status",
        "distribution",
        "links",
        "source_ids",
        "stock_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ie-retail-"
        },
        "module_id": {
          "const": "retailer_promotions"
        },
        "provider_id": {
          "enum": [
            "currys",
            "harvey_norman",
            "powercity",
            "expert"
          ]
        },
        "country": {
          "const": "IE"
        },
        "currency": {
          "const": "EUR"
        },
        "offer_kind": {
          "enum": [
            "price_observation",
            "product_discount",
            "handset_discount"
          ]
        },
        "product": {
          "type": "object",
          "required": [
            "sku",
            "name",
            "category",
            "condition"
          ],
          "properties": {
            "sku": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "category": {
              "enum": [
                "headphones",
                "speakers",
                "computers",
                "tablets",
                "phones",
                "storage",
                "wearables",
                "cameras",
                "gaming",
                "networking",
                "accessories",
                "monitors"
              ]
            },
            "condition": {
              "enum": [
                "new",
                "new_inferred",
                "unconfirmed"
              ]
            }
          }
        },
        "pricing": {
          "type": "object",
          "required": [
            "device_price_minor",
            "reference_price_minor",
            "reference_type",
            "discount_minor",
            "discount_percent",
            "reference_period"
          ],
          "properties": {
            "device_price_minor": {
              "type": "integer",
              "minimum": 0
            },
            "reference_price_minor": {
              "$ref": "#/$defs/nullableMoney"
            },
            "reference_type": {
              "enum": [
                null,
                "retailer_was_price",
                "manufacturer_rrp"
              ]
            },
            "discount_minor": {
              "$ref": "#/$defs/nullableMoney"
            },
            "discount_percent": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "reference_period": {
              "type": [
                "object",
                "null"
              ],
              "properties": {
                "starts_on": {
                  "type": "string",
                  "format": "date"
                },
                "ends_on": {
                  "type": "string",
                  "format": "date"
                }
              }
            },
            "observed_history": {
              "type": "object",
              "required": [
                "first_observed_on",
                "days_observed",
                "prior_30d_low_minor",
                "prior_30d_days_observed"
              ],
              "properties": {
                "first_observed_on": {
                  "type": "string",
                  "format": "date"
                },
                "days_observed": {
                  "type": "integer",
                  "minimum": 1
                },
                "prior_30d_low_minor": {
                  "$ref": "#/$defs/nullableMoney"
                },
                "prior_30d_days_observed": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "required": [
            "method",
            "observed_at",
            "origin_fetched_at",
            "fresh_until",
            "issues"
          ],
          "properties": {
            "observed_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "origin_fetched_at": {
              "$ref": "#/$defs/nullableTime"
            },
            "fresh_until": {
              "$ref": "#/$defs/nullableTime"
            },
            "issues": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "status": {
          "enum": [
            "price_only",
            "needs_review",
            "stale",
            "unconfirmed"
          ]
        },
        "distribution": {
          "type": "object",
          "required": [
            "can_list",
            "notification_ready"
          ],
          "properties": {
            "can_list": {
              "const": false
            },
            "notification_ready": {
              "const": false
            }
          }
        },
        "links": {
          "type": "object",
          "required": [
            "landing_url",
            "affiliate_url"
          ],
          "properties": {
            "landing_url": {
              "type": "string",
              "format": "uri"
            },
            "affiliate_url": {
              "type": "null"
            }
          }
        },
        "source_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "stock_status": {
          "enum": [
            "unknown",
            "in_stock",
            "available_to_order"
          ]
        }
      }
    }
  }
}
